# Python caches and local environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/

# Editor state
.idea/
.vscode/

# Local runtime dependencies, datasets, tools, and archives
/.third_party/
/data/
/weights/
/local_tools/
/archives/
/.artifact_sync/

# Model binaries and generated dataset caches
*.pt
*.onnx
*.engine
*.cache
events.out.tfevents.*

# Non-Study training outputs are machine-local
/runs/tasks/
/runs/sequences/

# A Study's protocol stays tracked; raw runs and derived results do not.
# Tracked: EXPERIMENT.md, config/, scripts/, experiment/variants/.
# Local/server artifacts: experiment/sequence/, experiment/task/, logs/, result/.
/runs/studies/*/experiment/sequence/*
!/runs/studies/*/experiment/sequence/.gitkeep
/runs/studies/*/experiment/task/*
!/runs/studies/*/experiment/task/.gitkeep
/runs/studies/*/logs/*
!/runs/studies/*/logs/.gitkeep
/runs/studies/*/result/*
!/runs/studies/*/result/.gitkeep

# Analysis method source remains tracked; generated analysis data stays local.
/data_analyse/**/results/
/result_analysis/**/results/
/result_analysis/train_test_overfitting/20*/
/result_analysis/*.exe

# Reusable chart code stays tracked; generated chart payloads do not.
/charts/**/*.png
/charts/**/*.svg
/charts/**/*.csv
/charts/**/*.html
/charts/**/summary.json
/charts/**/fixed_confidence_cache/
/charts/**/analysis.md
/charts/**/comparison_summary.md
/charts/**/complete_report.md
/charts/**/fixed_confidence_tables.md
/charts/**/metrics_tables.md

# Rendered reports are synchronized outside Git.
/reports/

